# Sage payload defaults for the local OpenAI-compatible API proxy.
SAGE_FILENAME=sage-goad-fresh
SAGE_PROVIDER=OpenAI
SAGE_MODEL=gpt-5.5-cyber-preview
SAGE_API_ENDPOINT=http://127.0.0.1:8100/v1
SAGE_API_KEY=dummy-key

# Apollo payload defaults for the CASTELBLACK foothold.
# Set this to the Mythic host address reachable from GOAD.
APOLLO_CALLBACK_HOST=
APOLLO_FILENAME=apollo-castelblack-fresh.exe
APOLLO_CALLBACK_PORT=80
APOLLO_CALLBACK_INTERVAL=3
APOLLO_CALLBACK_JITTER=23
APOLLO_AESPSK=aes256_hmac
APOLLO_GET_URI=index
APOLLO_POST_URI=data
APOLLO_QUERY_PATH_NAME=q
APOLLO_OUTPUT_TYPE=WinExe
APOLLO_ADJUST_FILENAME=false
APOLLO_DEBUG=false
APOLLO_DOWNLOAD_DIR=/tmp/sage_payloads
