# Source-control and local development metadata
.git
.agents
.codex
.pytest_cache
__pycache__
**/__pycache__
*.py[cod]

# Secrets and machine-local configuration
.env
.env.*
certs/*.pem

# Operator-supplied tool binaries. Sage ships none; a local build must not bake an operator's drop zone into an
# image layer. The installed service directory is mounted over /Mythic at runtime, which is where they belong.
tools/*
!tools/.keep

# Runtime state and retained evidence. These are archived data, never image input.
.phoenix
.sage_engagement
.trajectory
.hillclimb
sage*.db*
sage.log

# Development-only code retained in the monorepo but not shipped in the Mythic image.
ai/hillclimb
evals
tests
Payload_Type
MEMORY
