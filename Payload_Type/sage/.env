# Sage runtime environment.
#
# THIS FILE IS COMMITTED ON PURPOSE. Most projects ship a `.env.example` and make you copy it,
# which would mean getting a shell inside the Sage container. Shipping the real file instead means
# you can open it straight from the Mythic web UI — browse the Sage chat container's files, edit,
# save, restart the container. No shell, no `docker cp`, no sudo.
#
# ── How it loads ────────────────────────────────────────────────────────────────────────────────
# `main.py` reads this file before anything else starts, and applies two rules:
#
#   1. A variable already set in the environment WINS. Mythic injects its own configuration into
#      the container and nothing here can override it. That is why the Mythic-managed variables
#      live in the local-development section at the bottom rather than up here.
#   2. An EMPTY value is ignored. `KEY=` sets nothing. Uncommenting a line and leaving it blank is
#      exactly the same as leaving it commented, so you cannot accidentally define an empty
#      variable that later reads as "configured" and disables a fallback.
#
# So: uncomment a line AND give it a value, or it does nothing.
#
# ── Where else these can be set ─────────────────────────────────────────────────────────────────
# Everything below can also be set per-chat in the Mythic chat configuration, or as a Mythic user
# secret. Full order, highest first: chat configuration -> user secret -> container environment ->
# .env.local -> this file -> built-in default. Use this file for values shared by EVERY chat in this
# container, the chat configuration for per-chat values, and user secrets for anything sensitive.
#
# ── Running Sage locally? Use .env.local, not this file ─────────────────────────────────────────
# This file is TRACKED and must ship credential-free, and inert apart from one deliberate exception:
# the security default in the Sage behaviour section below, which is unsafe when absent rather than
# merely unset. Guard tests enforce both halves, because this lands in a public repository. So do not
# put your provider, model, endpoint, API key, or machine-specific paths here. Put them in
# `.env.local` beside this file:
#
#     printf 'provider=openai\nmodel=your-model\n' > Payload_Type/sage/.env.local
#
# `.env.local` is gitignored, is loaded BEFORE this file, and wins on every key it sets — load order
# is the precedence rule, since a variable already set is never overwritten. A container never sees
# it: the file is not in the image, and Mythic's injected environment outranks both files anyway.
#
# (If you have already edited this file and want git to stop watching your copy, the escape hatch is
# `git update-index --skip-worktree Payload_Type/sage/.env` — but that hides the change rather than
# fixing it, and the guard tests will still fail. Moving the values to `.env.local` is the fix.)


# ── Model provider ──────────────────────────────────────────────────────────────────────────────
# provider: openai, bedrock, anthropic, or ollama.
#provider=
#model=
# Optional OpenAI-compatible or provider endpoint.
#API_ENDPOINT=
#API_KEY=


# ── Assisted operation memory ──────────────────────────────────────────────────────────────────
# These are resource ceilings, not authority controls. Hitting one marks only the affected
# operation degraded and leaves deferred/rescan work visible; Mythic remains the source of truth.
#SAGE_OPERATION_MEMORY_MAX_MODEL_INPUT_TOKENS=100000
#SAGE_OPERATION_MEMORY_MAX_INLINE_TEXT_BYTES=65536
#SAGE_OPERATION_MEMORY_MAX_MODEL_CALLS_PER_UPDATE=5
#SAGE_OPERATION_MEMORY_BACKFILL_BATCH_SIZE=500
#SAGE_OPERATION_MEMORY_MAX_QUEUED_UPDATES=100

# Background watcher authentication. Create one persistent scoped API token for an active Mythic
# bot whose current operation is the operation Sage will watch. Required stored grants are:
# callback.read, chat-ai.read, chat.write, credential.read, eventlog.write, file.read,
# operation.read, response.read, and task.read. The set must match exactly; wildcard and excess
# scopes fail closed so the background principal cannot silently acquire action authority.
# Mythic expands chat.write to chat.read and eventlog.write to eventlog.read; those effective
# read scopes are also checked exactly.
# Sage uses Mythic's short-lived onStart token once to ready the standard findings channel, then
# discards it; polling and delivery authenticate only with this persistent token.
# Keep the real token in Mythic's injected environment or `.env.local`, never in this tracked file.
#SAGE_WATCHER_APITOKEN=
# The first-class `Sage Watcher` AI profile uses only these namespaced LLM values. It never falls
# back to ordinary Sage's provider/model/API_*/AWS_* keys. Resolution matches Sage Chat: channel
# config -> identically named optional user secret (endpoint/key/AWS only) -> environment -> default.
# The locked owner must run `/watcher apply`; creating the channel or editing config is inert.
#SAGE_WATCHER_PROVIDER=openai
#SAGE_WATCHER_MODEL=
#SAGE_WATCHER_API_ENDPOINT=
#SAGE_WATCHER_API_KEY=
#SAGE_WATCHER_AWS_ACCESS_KEY_ID=
#SAGE_WATCHER_AWS_SECRET_ACCESS_KEY=
#SAGE_WATCHER_AWS_SESSION_TOKEN=
#SAGE_WATCHER_AWS_DEFAULT_REGION=
# Polling is serial and incremental from durable Mythic watermarks. Cadence defaults to 300 seconds,
# accepts 5-86400, and persists with the applied operation profile across restart.
#SAGE_WATCHER_INTERVAL_SECONDS=300

# Optional Slack egress for material findings changes. Slack is outside the trusted Mythic/Sage
# client-data boundary, so Sage sends only a fixed generic notice with no operation or finding data.
# Full content remains in native Mythic Chat. Leave unset to disable all Slack delivery.
#SAGE_FINDINGS_SLACK_WEBHOOK_URL=
# Modern Slack app incoming webhooks are permanently bound to their installed channel; configure a
# separate webhook URL for each modern destination. Legacy custom-integration webhooks may honor
# this optional C/G channel ID. It is operator routing metadata, never a finding-derived value.
#SAGE_FINDINGS_SLACK_CHANNEL_ID=


# ── AWS Bedrock ─────────────────────────────────────────────────────────────────────────────────
# Only used when provider=bedrock.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#AWS_DEFAULT_REGION=


# ── BloodHound MCP ──────────────────────────────────────────────────────────────────────────────
# Connection details for BloodHound CE. Sage forwards these into the MCP server subprocess: the MCP
# stdio client passes a subprocess only a fixed safe subset of the environment, so these never
# reach the server by inheritance and must be resolved here or in the chat configuration.
# ONE address: scheme, host and port together. Sage splits it back into the three variables the
# MCP server reads, so you never set those yourself. The example below is a stock BloodHound CE;
# change it to wherever yours actually listens. Address only — a path, query or credentials in the
# URL are refused rather than silently trimmed, so do not paste a browser URL like .../ui/login.
#BLOODHOUND_URL=http://localhost:8080
#BLOODHOUND_TOKEN_ID=
#BLOODHOUND_TOKEN_KEY=

# Path to the BloodHound MCP server checkout. The container image bakes /opt/bloodhound_mcp, so
# leave this unset unless you are pointing Sage at your own checkout.
#SAGE_BLOODHOUND_MCP_DIR=


# ── Sage behaviour ──────────────────────────────────────────────────────────────────────────────
# hybrid, symbolic, or llm capability selection.
#SAGE_POLICY_MODE=
# Password used by operator helpers that run commands as another user on the range.
#SAGE_RUN_AS_PASSWORD=

# ── Timeouts: set these for any engagement whose callbacks sleep ────────────────────────────────
# The defaults are lab numbers. On a range a callback answers in seconds; an agent sleeping for OPSEC
# reasons cannot answer inside five minutes at all, so on real work the defaults will time out every
# task rather than occasionally.
#
# Base wall-clock budget in seconds for one Mythic task. Sage RAISES this automatically for a callback
# whose sleep interval it can establish, so set it for the engagement's floor, not its worst case.
#SAGE_MYTHIC_TASK_TIMEOUT=300
#
# Sleep cycles a task may wait through when the budget is raised. A task needs one cycle to be picked
# up and one to return, plus jitter, so values below 2 will time out on a healthy callback.
#SAGE_MYTHIC_SLEEP_TIMEOUT_MULTIPLIER=3
#
# Seconds a graph node may go without progress before LangGraph cancels it. This is a STALL DETECTOR
# and is deliberately independent of how long your callbacks sleep: a waiting Mythic task announces
# itself with a heartbeat for as long as it waits, so silence past this window means stuck, not
# patient. Raising SAGE_MYTHIC_TASK_TIMEOUT for a sleepy engagement does NOT need this raised too.
#SAGE_NODE_IDLE_TIMEOUT=300
#
# Seconds between those heartbeats. Must stay comfortably under half of SAGE_NODE_IDLE_TIMEOUT or a
# waiting node can be cancelled between beats; Sage warns at startup when it isn't.
#SAGE_TASK_HEARTBEAT_INTERVAL=30

# Restrict LangGraph checkpoint deserialization to a known-safe type allowlist.
#
# This is the one value in this file that ships SET rather than commented, deliberately. LangGraph
# defaults it to false, and false means any Python callable stored in checkpoint data is imported and
# executed when a checkpoint loads. Sage's checkpoint DB holds AD enumeration output, command results,
# and credential material gathered in adversary-adjacent environments, so anyone who can write to
# sage.db would otherwise get code execution inside the Sage process on the next resume.
#
# Leaving it commented would inherit the unsafe default, which is the opposite of every other line
# here: elsewhere a comment means "no opinion", but for this variable no opinion means insecure.
#
# The Dockerfile also sets it, so the shipped image is hardened even if this file is replaced.
LANGGRAPH_STRICT_MSGPACK=true


# ── LangSmith tracing (optional) ────────────────────────────────────────────────────────────────
# Sage ships Phoenix tracing enabled; LangSmith is an additional, separate backend.
#LANGSMITH_TRACING=true
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#LANGSMITH_PROJECT=Sage
#LANGSMITH_API_KEY=


# ── Local development only ──────────────────────────────────────────────────────────────────────
# DO NOT set these when running as a Mythic container. Mythic injects them itself, and since a
# value already in the environment wins, anything here would be ignored anyway — leaving them
# commented keeps that unambiguous rather than merely harmless.
#
# Set them only when running Sage as a local process outside Docker, where nothing injects them.
#RABBITMQ_HOST=127.0.0.1
#RABBITMQ_PASSWORD=
#MYTHIC_SERVER_HOST=127.0.0.1
#DEBUG_LEVEL=debug
