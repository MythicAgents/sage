# Settings for the optional Codex worker behind Sage's `/acp` command. See SETUP.md beside this file.
#
# Edit this file in place, from Mythic's file browser or a shell. Docker Compose reads it when you run
# `docker compose up -d --build` in this directory. After a change, recreate the worker (SETUP.md, "Change the key or
# model") and run `/acp connect codex` again. Restarting or rebuilding Sage keeps this file; reinstalling Sage with
# `mythic-cli install` deletes it, so keep a copy of your key elsewhere (SETUP.md, "Before you reinstall Sage").

# OpenAI API key Codex uses. Anyone who can read Sage's files can read it here, as with the key in Sage's own .env,
# and anyone with Docker access can see it in the worker's environment.
CODEX_API_KEY=

# Default model for new connections. Leave empty for Codex's own default. Use a model ID that `/acp models` lists;
# `/acp model <id>` still changes it per chat.
CODEX_MODEL=

# Numeric user and group that own Sage's service directory (Sage runs as that user). Check with:
# stat -c '%u %g' <mythic>/InstalledServices/sage
SAGE_CODEX_UID=1000
SAGE_CODEX_GID=1000

# `bridge` lets Codex reach its model provider. `none` disables networking (connection and model checks only).
SAGE_CODEX_NETWORK=bridge
