.DS_STORE
.vscode/
**/__pycache__/
.npmrc
package.json
package-lock.json
# CLAUDE.md is committed (it imports AGENTS.md and adds the Claude-specific subset).
# Personal, machine-specific notes go in CLAUDE.local.md, which Claude Code loads right after it.
CLAUDE.local.md
venv/
Notes
Plans
sage.db*
Payload_Type/sage/sage*.db*
.claude/
.env
skills/sage-callback-bootstrap/*_callback_config.json
.evals/
.mcp.json
.envrc
skills/sage-eval-gauge/.env.local

# Phoenix observability directory - ignore contents but keep structure
Payload_Type/sage/.phoenix/*
!Payload_Type/sage/.phoenix/.keep

# Operator tool binary drop zone - ignore contents but keep structure
Payload_Type/sage/tools/*
!Payload_Type/sage/tools/.keep

# SSL certificate bundles - exclude from version control
Payload_Type/sage/certs/*.pem
Payload_Type/sage/sage.log
Payload_Type/sage/evals/results/

# Sage durable engagement-state ledger and local analysis artifacts (runtime state — never commit)
.sage_engagement/
.hillclimb/
**/.trajectory/
**/MEMORY/audit.jsonl
.r5_preflight/

# Private durable Codex/Sage contracts, handoffs, reviews, transcripts, and evidence
.sage_history/
